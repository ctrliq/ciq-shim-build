# Generated metadata files
metadata-*.json

# Backup files
*.bak
*.backup-*

# Temporary build directories
binaries-*/
output/

# Docker build logs (these go in mock-build-*/, not tracked)
mock-build-*/docker-build-*.log

# Mock build RPMs (artifacts from mock builds, not needed)
mock-build-*/*.rpm

# Python cache
__pycache__/
*.pyc
